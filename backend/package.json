{
  "name": "practical-12-backend",
  "version": "1.0.0",
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions (Automated Testing & Linting)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
